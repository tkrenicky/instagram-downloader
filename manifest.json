{
  "manifest_version": 3,
  "name": "Instagram Public Downloader",
  "version": "1.1.0",
  "description": "Downloads public Instagram feed and highlight images using your existing Instagram login.",
  "permissions": ["tabs"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {"service_worker": "extension/background.js"},
  "action": {
    "default_title": "IG Downloader",
    "default_popup": "extension/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["extension/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://instagram-downloader-tky.vercel.app/*"],
      "js": ["extension/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}